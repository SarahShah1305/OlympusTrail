{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.js\" vite.config.js playwright.config.js package.json index.html",
    "preview": "vite preview",
    "test:smoke": "playwright test tests/smoke.spec.js",
