{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python olympustrail/prepare_native.py && npm ci --prefix frontend && npm run build --prefix frontend",
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/layers/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "includeFiles": "{data/person1/arcadia_500m/**,olympustrail/_native/**}",
      "excludeFiles": "{tests/**,scripts/**,scripts_frontend/**,data/person1/sources/**,data/person1/arcadia_500m/sources/**,data/person1_complete/**,data/processed/**,frontend/node_modules/**,frontend/src/**}"
    }
  }
}
